modules = ["nodejs-20", "web", "postgresql-16", "python-3.12"]
  [agent]
expertMode = true
  integrations = ["stripe:1.0.0", "python_gemini_ai_integrations:1.0.0", "revenuecat:1.0.0"]

  [nix]
  channel = "stable-25_05"

  [userenv]

  [userenv.shared]
  DB_NAME = "reversepicks"
  PORT = "8000"
  REACT_APP_BACKEND_URL = ""
  EXPO_PUBLIC_API_URL = "http://localhost:8000"
  CDM_INVERSION_MODE = "live"
  SCENARIO_PRIORS_MODE = "live"
  LUCK_STRIP_ENABLED = "1"
  BETA_TEST_EMAILS = "tester1@gmail.com,tester2@icloud.com"
  REVENUECAT_PROJECT_ID = "proj3a3fd517"
  REVENUECAT_TEST_STORE_APP_ID = "app5e026f7361"
  REVENUECAT_APPLE_APP_STORE_APP_ID = "appce9b46665f"
  REVENUECAT_GOOGLE_PLAY_STORE_APP_ID = "app37a722c43f"

  [workflows]
  runButton = "Project"

  [[workflows.workflow]]
  name = "Project"
  mode = "parallel"
  author = "agent"

  [[workflows.workflow.tasks]]
  task = "workflow.run"
  args = "Start application"

  [[workflows.workflow]]
  name = "Start application"
  author = "agent"

  [workflows.workflow.metadata]
  outputType = "webview"

  [[workflows.workflow.tasks]]
  task = "shell.exec"
  args = "cd mobile && PRODUCTION=true node proxy.js"
  waitForPort = 5000

  [[workflows.workflow]]
  name = "Start Backend"
  author = "agent"

  [workflows.workflow.metadata]
  outputType = "console"

  [[workflows.workflow.tasks]]
  task = "shell.exec"
  args = "mkdir -p /home/runner/.reversepicks_db && (mongod --dbpath /home/runner/.reversepicks_db --logpath /home/runner/.reversepicks_mongo.log --fork --quiet 2>/dev/null || true) && sleep 5 && cd backend && /home/runner/workspace/.pythonlibs/bin/python3.12 -m uvicorn server:app --host 0.0.0.0 --port 8000"
  waitForPort = 8000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 5002
externalPort = 4200

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 23636
externalPort = 3000

  [deployment]
  deploymentTarget = "vm"
  run = ["bash", "-c", "mkdir -p /home/runner/.reversepicks_db && mongod --dbpath /home/runner/.reversepicks_db --logpath /home/runner/.reversepicks_mongo.log --fork --quiet 2>/dev/null; (sleep 5 && cd /home/runner/workspace/backend && /home/runner/workspace/.pythonlibs/bin/python3.12 -m uvicorn server:app --host 0.0.0.0 --port 8000) & cd /home/runner/workspace/mobile && PRODUCTION=true node proxy.js"]
  build = ["bash", "-c", "echo 'Build: 1782350093718' && cd mobile && ([ -f dist/index.html ] && echo '[BUILD] dist already present, skipping export.' || (([ -d node_modules ] || npm install --legacy-peer-deps --silent) && npx expo export -p web --output-dir dist)) && echo '[BUILD] dist ready.'"]

  [postMerge]
  path = "scripts/post-merge.sh"
  timeoutMs = 120000
  