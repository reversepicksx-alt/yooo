modules = ["python-3.12", "nodejs-20", "web", "postgresql-16"]
[agent]
expertMode = true
integrations = ["stripe:1.0.0"]

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
MONGO_URL = "mongodb+srv://josselj001_db_user:BjAzgoASteNCPRft@reverse.4h7msnc.mongodb.net/?appName=Reverse&tls=true&tlsAllowInvalidCertificates=true"
